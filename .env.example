# Host the app points at for the backend API + Socket.IO connection.
# src/config.js builds API_URL and SOCKET_URL as http://<host>:5000.
# If unset, falls back to Expo's dev-server host (LAN dev) or "localhost".
EXPO_PUBLIC_API_HOST=localhost

# Full backend URL, required for a production/EAS build — a store build has no
# debugger host and no LAN, so without this it would silently try localhost on
# the driver's phone. Takes priority over EXPO_PUBLIC_API_HOST. Set for real in
# eas.json's production build profile, not here.
# EXPO_PUBLIC_API_URL=https://your-backend.onrender.com
# Optional: only needed if the socket URL differs from EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_SOCKET_URL=
